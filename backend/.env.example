# Obtain these from `neon env pull`; never add real values to git or Flutter.
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_ENDPOINT_URL_S3=
AWS_REGION=
NEON_BUCKET=uploads

# Firebase Admin uses Application Default Credentials on Cloud Run.
# Local development: set GOOGLE_APPLICATION_CREDENTIALS to a service account file.
CORS_ORIGINS=https://gen-lang-client-0915748775.web.app,http://localhost:5000
MAX_FILE_BYTES=104857600
SIGNED_URL_TTL_SECONDS=600

